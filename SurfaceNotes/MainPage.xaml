<Page
    x:Class="SurfaceNotes.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#ECEEF1">

    <Page.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="ToolToggle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: one slim row, nothing else -->
        <Grid Grid.Row="0" Background="#F7F8FA" BorderBrush="#DDE1E6" BorderThickness="0,0,0,1" Padding="4,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="2" Grid.Column="0">
                <Button Style="{StaticResource ToolButton}" Click="PaneButton_Click" ToolTipService.ToolTip="Notebooks and pages">
                    <SymbolIcon Symbol="GlobalNavigationButton" />
                </Button>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center" Margin="8,0,16,0" Foreground="#555" MaxWidth="260" TextTrimming="CharacterEllipsis" />

                <ToggleButton x:Name="PenTool" Style="{StaticResource ToolToggle}" Click="Tool_Click" Tag="Pen" IsChecked="True" ToolTipService.ToolTip="Pen">
                    <SymbolIcon Symbol="Edit" />
                </ToggleButton>
                <ToggleButton x:Name="HighlighterTool" Style="{StaticResource ToolToggle}" Click="Tool_Click" Tag="Highlighter" ToolTipService.ToolTip="Highlighter">
                    <SymbolIcon Symbol="Highlight" />
                </ToggleButton>
                <ToggleButton x:Name="EraserTool" Style="{StaticResource ToolToggle}" Click="Tool_Click" Tag="Eraser" ToolTipService.ToolTip="Eraser (or flip the pen)">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE75C;" />
                </ToggleButton>
                <ToggleButton x:Name="LassoTool" Style="{StaticResource ToolToggle}" Click="Tool_Click" Tag="Lasso" ToolTipService.ToolTip="Lasso select (or hold the pen button)">
                    <SymbolIcon Symbol="SelectAll" />
                </ToggleButton>

                <Border Width="1" Margin="6,8" Background="#DDE1E6" />

                <ToggleButton x:Name="ColorBlack" Style="{StaticResource ToolToggle}" Click="Color_Click" Tag="#FF111111" IsChecked="True">
                    <Ellipse Width="18" Height="18" Fill="#111111" />
                </ToggleButton>
                <ToggleButton x:Name="ColorBlue" Style="{StaticResource ToolToggle}" Click="Color_Click" Tag="#FF1E5BD8">
                    <Ellipse Width="18" Height="18" Fill="#1E5BD8" />
                </ToggleButton>
                <ToggleButton x:Name="ColorRed" Style="{StaticResource ToolToggle}" Click="Color_Click" Tag="#FFD0312D">
                    <Ellipse Width="18" Height="18" Fill="#D0312D" />
                </ToggleButton>
                <ToggleButton x:Name="ColorGreen" Style="{StaticResource ToolToggle}" Click="Color_Click" Tag="#FF2E8B57">
                    <Ellipse Width="18" Height="18" Fill="#2E8B57" />
                </ToggleButton>

                <Border Width="1" Margin="6,8" Background="#DDE1E6" />

                <ToggleButton x:Name="SizeThin" Style="{StaticResource ToolToggle}" Click="Size_Click" Tag="1.5" ToolTipService.ToolTip="Fine">
                    <Ellipse Width="4" Height="4" Fill="#333" />
                </ToggleButton>
                <ToggleButton x:Name="SizeMedium" Style="{StaticResource ToolToggle}" Click="Size_Click" Tag="3" IsChecked="True" ToolTipService.ToolTip="Medium">
                    <Ellipse Width="7" Height="7" Fill="#333" />
                </ToggleButton>
                <ToggleButton x:Name="SizeThick" Style="{StaticResource ToolToggle}" Click="Size_Click" Tag="6" ToolTipService.ToolTip="Thick">
                    <Ellipse Width="11" Height="11" Fill="#333" />
                </ToggleButton>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="2" Grid.Column="2">
                <Button Style="{StaticResource ToolButton}" Click="Undo_Click" ToolTipService.ToolTip="Undo (Ctrl+Z)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="Z" />
                    </Button.KeyboardAccelerators>
                    <SymbolIcon Symbol="Undo" />
                </Button>
                <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="DeleteSelection_Click" IsEnabled="False" ToolTipService.ToolTip="Delete selection (Del)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </Button.KeyboardAccelerators>
                    <SymbolIcon Symbol="Delete" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="ToText_Click" ToolTipService.ToolTip="Convert handwriting to text (selection, or the whole page)">
                    <SymbolIcon Symbol="Font" />
                </Button>
                <Button Style="{StaticResource ToolButton}" Click="AddPage_Click" ToolTipService.ToolTip="New page (Ctrl+N)">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </Button.KeyboardAccelerators>
                    <SymbolIcon Symbol="Add" />
                </Button>
            </StackPanel>
        </Grid>

        <SplitView x:Name="Split" Grid.Row="1" DisplayMode="Overlay" IsPaneOpen="False" OpenPaneLength="280" PaneBackground="#F7F8FA">
            <SplitView.Pane>
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <TextBlock Text="Notebooks" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Click="AddNotebook_Click" ToolTipService.ToolTip="New notebook">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                    </Grid>
                    <ListView x:Name="NotebookList" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="NotebookList_SelectionChanged" RightTapped="NotebookList_RightTapped" />

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="Pages" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource ToolButton}" Click="AddPage_Click" ToolTipService.ToolTip="New page">
                            <SymbolIcon Symbol="Add" />
                        </Button>
                    </Grid>
                    <ListView x:Name="PageList" Grid.Row="3" SelectionMode="Single"
                              SelectionChanged="PageList_SelectionChanged" RightTapped="PageList_RightTapped" />

                    <Button Grid.Row="4" Click="About_Click" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="8" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Setting" />
                            <TextBlock Text="About and updates" />
                        </StackPanel>
                    </Button>
                </Grid>
            </SplitView.Pane>

            <!-- Touch pans and pinch-zooms the page; only the pen (or mouse) writes. -->
            <ScrollViewer x:Name="Scroller"
                          ZoomMode="Enabled" MinZoomFactor="0.5" MaxZoomFactor="4"
                          HorizontalScrollMode="Auto" VerticalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          SizeChanged="Scroller_SizeChanged">
                <Grid x:Name="Sheet" Background="White" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Path x:Name="RuledLines" Stroke="#E3E9F0" StrokeThickness="1" IsHitTestVisible="False" />
                    <InkCanvas x:Name="Ink" />
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" />
                </Grid>
            </ScrollViewer>
        </SplitView>
    </Grid>
</Page>
